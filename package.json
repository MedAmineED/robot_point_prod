{
  "name": "robot-point-prod",
  "private": true,
  "description": "Point Prod robot: separate Telco and Energy extraction from Salesforce, Diabolocom and Grafana",
  "workspaces": [
    "shared",
    "sf_extraction",
    "diabolocom_extraction",
    "grafana_extraction",
    "robot"
  ],
  "scripts": {
    "extract": "npm --prefix sf_extraction start",
    "extract:diabolocom": "npm --prefix diabolocom_extraction start",
    "extract:grafana": "npm --prefix grafana_extraction start",
    "extract:all": "npm run extract && npm run extract:diabolocom && npm run extract:grafana",
    "robot": "npm --prefix robot start",
    "robot:push": "npm --prefix robot run push",
    "robot:schedule": "npm --prefix robot run schedule",
    "test": "npm test --workspaces --if-present",
    "robot:telco": "npm --prefix robot start -- --job telco",
    "robot:energy": "npm --prefix robot start -- --job conquest-energy"
  }
}
