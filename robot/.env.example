# Point Prod robot: copy to robot/.env and fill in. Never commit robot/.env.
# Run from the repository root:  npm run robot            (extract now, then send)
#                              npm run robot:schedule   (repeat at the slots of robot/config/robot.json)
#                              npm run robot:push       (resend the latest files without extracting)
# Requires Node.js 22+ and Google Chrome on the machine that runs the robot.
# Every value below is passed to the extractors; their own .env files become optional.

# ---------------------------------------------------------------------------
# Point Prod API (the hosted server)
# ---------------------------------------------------------------------------
# Where the robot sends the data. Overrides "apiUrl" of robot/config/robot.json.
ROBOT_API_URL=https://point-prod.nrjcallcenter.com/api
# Shared secret, must be identical to ROBOT_API_KEY in the server's api/.env.
ROBOT_API_KEY=

# ---------------------------------------------------------------------------
# Salesforce (extractors/salesforce): sales
# ---------------------------------------------------------------------------
SF_USERNAME=
SF_PASSWORD=

# login-tools: provides the Salesforce 2FA code ("Salesforce 2FA NCC Tunis TL",
# set in extractors/salesforce/config/config.json > loginTools.code.tokenName)
LOGIN_TOOLS_EMAIL=
LOGIN_TOOLS_PASSWORD=

# ---------------------------------------------------------------------------
# Diabolocom (extractors/diabolocom): leads = inbound calls
# ---------------------------------------------------------------------------
DIABOLOCOM_USERNAME=
DIABOLOCOM_PASSWORD=

# ---------------------------------------------------------------------------
# Grafana (extractors/grafana): TR_GRAFANA and QOS_GRAFANA KPIs
# ---------------------------------------------------------------------------
# Keep the single quotes: a # in an unquoted value would start a comment.
GRAFANA_USERNAME=
GRAFANA_PASSWORD=''

# ---------------------------------------------------------------------------
# Browser (optional)
# ---------------------------------------------------------------------------
# Chrome used by the extractors. Default: /usr/bin/google-chrome
# (Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe)
# CHROME_PATH=/usr/bin/google-chrome
# Optional override: true for headless automation, false for a visible Chrome window.
# Omit to keep each extractor's existing configured mode.
# CHROME_HEADLESS=true

# ---------------------------------------------------------------------------
# Where the rest is configured (no secrets there)
# ---------------------------------------------------------------------------
# robot/config/robot.json                       schedule (every 120 min, 10:00-20:00, Africa/Tunis), jobs, field mapping
# extractors/salesforce/config/reports/*.json   Salesforce report id and filters
# extractors/diabolocom/config/reports/*.json   Diabolocom groups, period, columns
# extractors/grafana/config/reports/*.json      Grafana dashboard, panel and row of each KPI
# extractors/*/config/config.json               "headless": true to run without a visible browser window
